# CrowdGuard Command — Backend Environment Variables
# Copy to .env and fill in your values

# ── Google AI / Gemini ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ── Google Cloud Platform ────────────────────────────────────────────────────
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# Used as data bus between services
GCS_BUCKET_NAME=crowdguard-sensor-data

# ── Alert Delivery ────────────────────────────────────────────────────────────
# Optional: Pub/Sub topic for alert fan-out
ALERT_PUBSUB_TOPIC=projects/your_project_id/topics/crowdguard-alerts

# Optional: Webhook URL for operator dashboard alerts
ALERT_WEBHOOK_URL=

# ── Video Processor ────────────────────────────────────────────────────────────
YOLO_MODEL_SIZE=yolov8n

# ── Service Ports ─────────────────────────────────────────────────────────────
PORT=8000
VIDEO_PROCESSOR_PORT=8001
